        "kind": "upstash-redis",
        "perBranch": true
      },
      {
        "id": "execution-runner",
        "concern": "execution-compute",
        "kind": "container-runner",
        "perBranch": true
      }
    ],
    "staging": [
      {
        "id": "experience",
        "concern": "experience-delivery",
        "kind": "vercel-project"
      },
      {
        "id": "database-project",
        "concern": "relational-state",
        "kind": "neon-project"
      },
      {
        "id": "database",
        "concern": "relational-state",
        "kind": "neon-branch"
      },
      {
        "id": "object-store",
        "concern": "artifact-bytes",
        "kind": "r2-bucket"
      },
      {
        "id": "dispatch",
        "concern": "async-transport",
        "kind": "cf-queue"
      },
      {
        "id": "orchestration",
        "concern": "durable-orchestration",
        "kind": "cf-workflow"
      },
      {
        "id": "redis",
        "concern": "ephemeral-coordination",
        "kind": "upstash-redis"
      },
      {
        "id": "execution-runner",
        "concern": "execution-compute",
        "kind": "container-runner"
      }
    ],
    "production": [
      {
        "id": "experience",
        "concern": "experience-delivery",
        "kind": "vercel-project"
      },
      {
        "id": "database-project",
        "concern": "relational-state",
        "kind": "neon-project"
      },
      {
        "id": "database",
        "concern": "relational-state",
        "kind": "neon-branch"
      },
      {
        "id": "object-store",
        "concern": "artifact-bytes",
        "kind": "r2-bucket"
      },
      {
        "id": "dispatch",
        "concern": "async-transport",
        "kind": "cf-queue"
      },
      {
        "id": "orchestration",
        "concern": "durable-orchestration",
        "kind": "cf-workflow"
      },
      {
        "id": "redis",
        "concern": "ephemeral-coordination",
        "kind": "upstash-redis"
      },
      {
        "id": "execution-runner",
        "concern": "execution-compute",
        "kind": "container-runner"
      }
    ]
  },
  "previewBranching": {
    "databaseParent": "staging",
    "description": "Preview Neon branches descend from the staging project's main branch so previews prove staging-shaped topology with disposable data."
  }
}
