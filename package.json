{
  "name": "@pectoraux/ai-execution-os",
  "private": true,
  "version": "0.1.0",
  "description": "AI Execution OS — governed, provider-independent AI execution infrastructure",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "governance:check": "python3 scripts/governance-check.py",
