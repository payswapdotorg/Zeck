{
  "name": "@pectoraux/ai-execution-os",
  "private": true,
  "version": "0.1.0",
  "description": "AI Execution OS — governed, provider-independent AI execution infrastructure",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "governance:check": "python3 scripts/governance-check.py",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:architecture": "vitest run tests/architecture tests/discrimination",
    "test": "vitest run",
    "test:pg": "vitest run tests/integration/postgres",
    "deploy:validate": "bun deploy/validate.ts",
    "deploy:bootstrap": "bun deploy/bootstrap.ts",
    "deploy:teardown": "bun deploy/teardown.ts",
    "deploy:smoke": "bun deploy/smoke.ts",
    "deploy:identity": "bun deploy/identity.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "fastify": "^5.12.1"
  }
}
