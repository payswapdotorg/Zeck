{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastify",
  "redirects": [
    {
      "source": "/",
      "destination": "/home",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/api/experience?path=/home"
    },
    {
      "source": "/home/:path*",
      "destination": "/api/experience?path=/home/:path*"
    },
    {
      "source": "/build",
      "destination": "/api/experience?path=/build"
    },
    {
      "source": "/build/:path*",
      "destination": "/api/experience?path=/build/:path*"
    },
    {
      "source": "/deployments",
      "destination": "/api/experience?path=/deployments"
    },
    {
      "source": "/deployments/:path*",
      "destination": "/api/experience?path=/deployments/:path*"
    },
    {
      "source": "/runs",
      "destination": "/api/experience?path=/runs"
    },
    {
      "source": "/runs/:path*",
      "destination": "/api/experience?path=/runs/:path*"
    },
    {
      "source": "/assets",
      "destination": "/api/experience?path=/assets"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/experience?path=/assets/:path*"
    },
    {
      "source": "/improve",
      "destination": "/api/experience?path=/improve"
    },
    {
      "source": "/improve/:path*",
      "destination": "/api/experience?path=/improve/:path*"
    },
    {
      "source": "/console",
      "destination": "/api/experience?path=/console"
    },
    {
      "source": "/console/:path*",
      "destination": "/api/experience?path=/console/:path*"
    },
    {
      "source": "/trust",
      "destination": "/api/experience?path=/trust"
    },
    {
      "source": "/trust/:path*",
      "destination": "/api/experience?path=/trust/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api/experience?path=/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/experience?path=/admin/:path*"
    },
    {
      "source": "/command",
      "destination": "/api/experience?path=/command"
    },
    {
      "source": "/attention",
      "destination": "/api/experience?path=/attention"
    },
    {
      "source": "/mode",
      "destination": "/api/experience?path=/mode"
    },
    {
      "source": "/appearance",
      "destination": "/api/experience?path=/appearance"
    }
  ]
}
